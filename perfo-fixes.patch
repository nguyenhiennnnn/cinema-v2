+/**
+ * Chuẩn hóa chuỗi để so khớp tìm kiếm: bỏ dấu tiếng Việt, về chữ thường, cắt khoảng trắng.
+ * VD: "Hành Động" → "hanh dong", "Đạo diễn" → "dao dien".
+ */
+export function normalizeText(value: string): string {
+  return value
+    .toLowerCase()
+    .normalize("NFD")
+    .replace(/[\u0300-\u036f]/g, "")
+    .replace(/đ/g, "d")
+    .trim();
+}
+
+/** `label` có chứa `search` không (không phân biệt hoa thường và dấu). */
+export function matchesSearch(label: string, search: string): boolean {
+  return normalizeText(label).includes(normalizeText(search));
+}
