diff --git a/backend/Cinema.Application/Interfaces/IAiModelClient.cs b/backend/Cinema.Application/Interfaces/IAiModelClient.cs
new file mode 100644
index 0000000..3c170ca
--- /dev/null
+++ b/backend/Cinema.Application/Interfaces/IAiModelClient.cs
@@ -0,0 +1,19 @@
+using Cinema.Application.Services.Ai;
+
+namespace Cinema.Application.Interfaces;
+
+/// <summary>
+/// Cổng giao tiếp với mô hình ngôn ngữ. Application chỉ biết cổng này;
+/// nhà cung cấp cụ thể chỉ là một cài đặt cắm vào ở Infrastructure.
+/// </summary>
+public interface IAiModelClient
+{
+    /// <summary>Đã có đủ cấu hình (API key, ...) để gọi mô hình hay chưa.</summary>
+    bool IsConfigured { get; }
+
+    /// <summary>
+    /// Gửi một lượt hội thoại và nhận về tin nhắn của mô hình.
+    /// Ném <see cref="AiModelException"/> khi nhà cung cấp trả lỗi.
+    /// </summary>
+    Task<AiMessage> GenerateAsync(AiModelRequest request, CancellationToken cancellationToken);
+}
diff --git a/backend/Cinema.Application/Services/Ai/AiAssistantService.cs b/backend/Cinema.Application/Services/Ai/AiAssistantService.cs
new file mode 100644
index 0000000..f927d5f
--- /dev/null
+++ b/backend/Cinema.Application/Services/Ai/AiAssistantService.cs
@@ -0,0 +1,163 @@
+using System.Text.Json.Nodes;
+using Cinema.Application.DTOs.Ai;
+using Cinema.Application.Interfaces;
+using Microsoft.Extensions.Logging;
+
+namespace Cinema.Application.Services.Ai;
+
+/// <summary>
+/// Điều phối hội thoại với trợ lý AI: dựng ngữ cảnh, chạy vòng lặp gọi hàm,
+/// áp giới hạn, gom thẻ và xử lý lỗi. Nói chuyện với mô hình chỉ qua <see cref="IAiModelClient"/>.
+/// </summary>
+public class AiAssistantService(
+    IAiModelClient modelClient,
+    AiSystemPromptBuilder promptBuilder,
+    AiToolExecutor toolExecutor,
+    ILogger<AiAssistantService> logger
+) : IAiAssistantService
+{
+    private const int MaxToolRounds = 4;
+
+    private const int MaxTotalToolCalls = 8;
+
+    private const int MaxCards = 6;
+
+    private const double Temperature = 0.5;
+
+    private const int MaxOutputTokens = 2048;
+
+    public async Task<AiChatResponse> ChatAsync(
+        int? userId,
+        AiChatRequest request,
+        CancellationToken cancellationToken
+    )
+    {
+        if (!modelClient.IsConfigured)
+        {
+            logger.LogWarning("AI model client is not configured (missing API key).");
+            return new AiChatResponse(
+                "Xin lỗi, tính năng AI Assistant hiện chưa được cấu hình khóa API trên hệ thống. Vui lòng liên hệ Quản trị viên để thiết lập.",
+                DateTime.UtcNow
+            );
+        }
+
+        var systemPrompt = await promptBuilder.BuildSystemPromptAsync(userId, cancellationToken);
+        var tools = AiToolExecutor.GetToolDefinitions(userId.HasValue);
+
+        var messages = new List<AiMessage>();
+        if (request.History is not null)
+        {
+            foreach (var h in request.History)
+            {
+                var role = h.Role.ToLowerInvariant() == "user" ? AiMessageRole.User : AiMessageRole.Model;
+                messages.Add(AiMessage.FromText(role, h.Content));
+            }
+        }
+        messages.Add(AiMessage.FromText(AiMessageRole.User, request.Message));
+
+        var cards = new List<AiCardDto>();
+        var totalToolCalls = 0;
+
+        try
+        {
+            for (var round = 0; round <= MaxToolRounds; round++)
+            {
+                var allowTools = round < MaxToolRounds;
+
+                AiMessage modelMessage;
+                try
+                {
+                    modelMessage = await modelClient.GenerateAsync(
+                        new AiModelRequest(
+                            systemPrompt,
+                            messages,
+                            allowTools ? tools : [],
+                            Temperature,
+                            MaxOutputTokens
+                        ),
+                        cancellationToken
+                    );
+                }
+                catch (AiModelException ex)
+                {
+                    logger.LogError(ex, "AI model call failed.");
+                    return new AiChatResponse(
+                        "Rất tiếc, kết nối với trợ lý AI thất bại. Vui lòng thử lại sau.",
+                        DateTime.UtcNow,
+                        FinalizeCards(cards)
+                    );
+                }
+
+                var functionCalls = modelMessage.Parts.OfType<AiFunctionCallPart>().ToList();
+
+                if (!allowTools || functionCalls.Count == 0)
+                {
+                    var reply = string.Concat(
+                        modelMessage
+                            .Parts.OfType<AiTextPart>()
+                            .Select(p => p.Text)
+                            .Where(t => !string.IsNullOrEmpty(t))
+                    );
+
+                    if (string.IsNullOrWhiteSpace(reply))
+                        reply = "Trợ lý AI không tạo được câu trả lời phù hợp. Vui lòng thử lại.";
+
+                    return new AiChatResponse(reply.Trim(), DateTime.UtcNow, FinalizeCards(cards));
+                }
+
+                messages.Add(modelMessage);
+
+                var results = new List<AiMessagePart>();
+                foreach (var call in functionCalls)
+                {
+                    AiToolExecutor.ToolResult result;
+                    if (++totalToolCalls > MaxTotalToolCalls)
+                    {
+                        result = new AiToolExecutor.ToolResult(
+                            new JsonObject
+                            {
+                                ["error"] =
+                                    "Đã vượt quá số lần truy vấn cho phép, hãy trả lời với dữ liệu đã có.",
+                            },
+                            []
+                        );
+                    }
+                    else
+                    {
+                        result = await toolExecutor.ExecuteAsync(
+                            call.Name,
+                            call.Args,
+                            userId,
+                            cancellationToken
+                        );
+                        cards.AddRange(result.Cards);
+                    }
+
+                    results.Add(new AiFunctionResultPart(call.Name, result.Response));
+                }
+
+                messages.Add(new AiMessage(AiMessageRole.Tool, results));
+            }
+
+            return new AiChatResponse(
+                "Trợ lý AI không tạo được câu trả lời phù hợp. Vui lòng thử lại.",
+                DateTime.UtcNow
+            );
+        }
+        catch (OperationCanceledException)
+        {
+            throw;
+        }
+        catch (Exception ex)
+        {
+            logger.LogError(ex, "Lỗi khi xử lý hội thoại với Trợ lý AI.");
+            return new AiChatResponse(
+                "Đã xảy ra lỗi trong quá trình xử lý yêu cầu với Trợ lý AI. Vui lòng thử lại sau.",
+                DateTime.UtcNow
+            );
+        }
+    }
+
+    private static List<AiCardDto> FinalizeCards(List<AiCardDto> cards) =>
+        cards.DistinctBy(c => $"{c.Type}|{c.Link}").Take(MaxCards).ToList();
+}
diff --git a/backend/Cinema.Application/Services/Ai/AiModelContracts.cs b/backend/Cinema.Application/Services/Ai/AiModelContracts.cs
new file mode 100644
index 0000000..74571fd
--- /dev/null
+++ b/backend/Cinema.Application/Services/Ai/AiModelContracts.cs
@@ -0,0 +1,70 @@
+using System.Text.Json.Nodes;
+
+namespace Cinema.Application.Services.Ai;
+
+// Kiểu dữ liệu trung lập giữa bộ điều phối hội thoại và nhà cung cấp mô hình.
+// Không chứa bất kỳ cấu trúc JSON nào đặc thù của một nhà cung cấp.
+
+public enum AiMessageRole
+{
+    User,
+    Model,
+    Tool,
+}
+
+public abstract record AiMessagePart;
+
+public sealed record AiTextPart(string Text) : AiMessagePart;
+
+/// <summary>
+/// Mô hình yêu cầu gọi một hàm.
+/// <paramref name="ProviderState"/> là dữ liệu mờ do bộ chuyển đổi tự sinh ra
+/// (vd. chữ ký suy luận); bộ điều phối chỉ giữ nguyên và gửi lại ở lượt sau.
+/// </summary>
+public sealed record AiFunctionCallPart(
+    string Name,
+    JsonObject? Args,
+    string? ProviderState = null
+) : AiMessagePart;
+
+public sealed record AiFunctionResultPart(string Name, JsonObject Response) : AiMessagePart;
+
+public sealed record AiMessage(AiMessageRole Role, IReadOnlyList<AiMessagePart> Parts)
+{
+    public static AiMessage FromText(AiMessageRole role, string text) =>
+        new(role, [new AiTextPart(text)]);
+}
+
+public enum AiToolParameterType
+{
+    String,
+    Integer,
+    Number,
+    Boolean,
+}
+
+public sealed record AiToolParameter(
+    string Name,
+    AiToolParameterType Type,
+    string Description,
+    bool Required = false,
+    IReadOnlyList<string>? AllowedValues = null
+);
+
+public sealed record AiToolDefinition(
+    string Name,
+    string Description,
+    IReadOnlyList<AiToolParameter> Parameters
+);
+
+public sealed record AiModelRequest(
+    string SystemPrompt,
+    IReadOnlyList<AiMessage> Messages,
+    IReadOnlyList<AiToolDefinition> Tools,
+    double Temperature,
+    int MaxOutputTokens
+);
+
+/// <summary>Nhà cung cấp mô hình không phản hồi được (HTTP lỗi, ...).</summary>
+public class AiModelException(string message, Exception? inner = null)
+    : Exception(message, inner);
