{
  "name": "perfo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Perfo - he thong dat ve rap phim (backend .NET + frontend React). Moi lenh dev/build/test/db/docker chay tu thu muc goc; day la package.json duy nhat cua repo.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "// === SETUP (chay 1 lan sau khi clone) ===": "",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:tools": "dotnet tool restore",
    "setup:backend": "dotnet restore backend/Cinema.slnx",
    "setup:browsers": "playwright install chromium",
    "setup": "npm install && npm run setup:env && npm run setup:tools && npm run setup:backend",
    "// === DEV - CHAY THU CONG (khong Docker) ===": "",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "dotnet watch --project backend/Cinema.Api run",
    "dev:backend:once": "dotnet run --project backend/Cinema.Api",
    "dev:frontend": "vite frontend",
    "// === BUILD / PREVIEW ===": "",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "dotnet build backend/Cinema.slnx",
    "build:frontend": "tsc -b frontend && vite build frontend",
    "build:frontend:full": "npm run build:frontend && node frontend/scripts/build-sitemap.mjs",
    "preview:frontend": "vite preview frontend",
    "sitemap:frontend": "node frontend/scripts/build-sitemap.mjs",
    "clean:backend": "dotnet clean backend/Cinema.slnx",
    "// === LINT / FORMAT / CHECK ===": "",
    "lint": "eslint --config frontend/eslint.config.js frontend",
    "typecheck": "tsc -b frontend",
    "format": "dotnet csharpier format .",
    "format:check": "dotnet csharpier check .",
    "check": "npm run format:check && npm run lint && npm run build",
    "// === DOCKER (docker-compose.yml: api + frontend, DB la Neon cloud) ===": "",
    "docker:up": "docker compose up --build -d",
    "docker:up:fg": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart",
    "docker:ps": "docker compose ps",
    "docker:build": "docker compose build",
    "docker:build:nocache": "docker compose build --no-cache",
    "docker:logs": "docker compose logs -f",
    "docker:logs:api": "docker compose logs -f api",
    "docker:logs:frontend": "docker compose logs -f frontend",
    "docker:exec:api": "docker compose exec api sh",
    "docker:exec:frontend": "docker compose exec frontend sh",
    "docker:prune": "docker system prune -f",
    "// === DATABASE - EF CORE. Tao migration: npm run db:migration:add -- TenMigration ===": "",
    "db:migration:add": "dotnet ef migrations add --project backend/Cinema.Infrastructure --startup-project backend/Cinema.Api",
    "db:migration:remove": "dotnet ef migrations remove --project backend/Cinema.Infrastructure --startup-project backend/Cinema.Api",
    "db:migration:list": "dotnet ef migrations list --project backend/Cinema.Infrastructure --startup-project backend/Cinema.Api",
    "db:migration:script": "dotnet ef migrations script --project backend/Cinema.Infrastructure --startup-project backend/Cinema.Api --idempotent --output backend/migration.sql",
    "db:update": "dotnet ef database update --project backend/Cinema.Infrastructure --startup-project backend/Cinema.Api",
    "db:drop": "dotnet ef database drop --project backend/Cinema.Infrastructure --startup-project backend/Cinema.Api --force",
    "db:reset": "npm run db:drop && npm run db:update",
    "db:info": "dotnet ef dbcontext info --project backend/Cinema.Infrastructure --startup-project backend/Cinema.Api",
    "// === UI - shadcn (chay: npm run ui:add -- button) ===": "",
    "ui:add": "shadcn add --cwd frontend",
    "// === TEST - BACKEND (.NET) ===": "",
    "test:unit": "dotnet test backend/tests/Cinema.UnitTests",
    "test:integration": "dotnet test backend/tests/Cinema.IntegrationTests",
    "test:backend": "npm run test:unit && npm run test:integration",
    "test:backend:watch": "dotnet watch test --project backend/tests/Cinema.UnitTests",
    "test:backend:coverage": "dotnet test backend/Cinema.slnx --collect:\"XPlat Code Coverage\"",
    "// === TEST - E2E (Playwright, can chay dev server truoc) ===": "",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:e2e:ui": "npm --prefix frontend run test:e2e:ui",
    "test:e2e:headed": "npm --prefix frontend run test:e2e:headed",
    "test:e2e:debug": "npm --prefix frontend run test:e2e:debug",
    "test:e2e:report": "npm --prefix frontend run -- playwright show-report playwright-report",
    "// === TEST - LOAD (k6, chay qua PowerShell) ===": "",
    "test:load:browse": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-load-test.ps1 -Scenario browse-movies-stress.js",
    "test:load:peak": "powershell -ExecutionPolicy Bypass -File ./load-tests/run-load-test.ps1 -Scenario peak-ticket-rush.js",
    "test:load": "npm run test:load:browse && npm run test:load:peak",
    "// === TEST - TONG HOP ===": "",
    "test": "npm run test:backend && npm run test:e2e",
    "test:all": "npm run test && npm run test:load"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@microsoft/signalr": "^10.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-table": "^9.2.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.34.0",
    "nuqs": "^2.10.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.86.0",
    "react-icons": "^5.7.0",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
