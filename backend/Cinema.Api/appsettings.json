{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "Hangfire": "Error"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "RunMigrationsOnStartup": false,

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=CinemaDb;Username=postgres;Password="
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "App": {
    "ApiBaseUrl": "http://localhost:8080",
    "FrontendBaseUrl": "http://localhost:5173"
  },

  "Jwt": {
    "Issuer": "Cinema",
    "Audience": "Cinema.Client",
    "Secret": "",
    "AccessTokenExpirationSeconds": 3600,
    "RefreshTokenExpirationDays": 30
  },

  "Booking": {
    "HoldDurationMinutes": 15,
    "RoomBufferMinutes": 15,
    "PointsPerVnd": 0.0001
  },

  "RateLimit": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 60,
    "BookingHoldPermitLimit": 10,
    "BookingHoldWindowSeconds": 60
  },

  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "MaxVideoFileSizeBytes": 104857600,
    "AllowedVideoExtensions": [".mp4", ".mov", ".webm", ".avi"]
  },

  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "no-reply@cinema.local",
    "FromName": "Cinema",
    "EmailConfirmationExpirationHours": 24,
    "PasswordResetExpirationMinutes": 30
  },

  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "",
