# ---- PostgreSQL ----
POSTGRES_PASSWORD=Your_strong_password_here
POSTGRES_USER=postgres
POSTGRES_DB=CinemaDb

# ---- Backend Runtime ----
ASPNETCORE_ENVIRONMENT=Development
RUN_MIGRATIONS_ON_STARTUP=true
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ---- JWT ----
JWT_SECRET=CHANGE_ME_GENERATE_YOUR_OWN_SECRET_MIN_64_CHARS
JWT_ISSUER=Cinema
JWT_AUDIENCE=Cinema.Client
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMTP (MailKit) ----
# Dùng cho local dev. Trên Render Free Tier, SMTP bị block → dùng RESEND_API_KEY thay thế.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@cinema.local
SMTP_FROM_NAME=Cinema

# ---- Resend (HTTP API email — hoạt động trên Render Free Tier) ----
# Đăng ký miễn phí tại https://resend.com → API Keys → tạo key
# Khi cấu hình biến này, SMTP bên trên sẽ bị bỏ qua hoàn toàn.
# QUAN TRỌNG: SMTP_FROM_ADDRESS phải là domain đã verify trên Resend
#             (hoặc dùng onboarding@resend.dev để test nhanh)
RESEND_API_KEY=

# ---- VNPay (sandbox) ----
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/booking/result
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ---- MoMo (sandbox) ----
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5173/booking/result
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo/ipn
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund

# ---- Stripe (test) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=http://localhost:5173/booking/result
STRIPE_CURRENCY=vnd

# ---- Gemini AI ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Frontend (Vite build-time vars — baked in at build, not runtime) ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SIGNALR_HUB_URL=http://localhost:8080/hubs/showtimes
VITE_GOOGLE_CLIENT_ID=
