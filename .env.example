# ---- PostgreSQL (Neon Cloud) ----
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---- Backend Runtime ----
ASPNETCORE_ENVIRONMENT=Development
RUN_MIGRATIONS_ON_STARTUP=true
FRONTEND_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ---- JWT ----
JWT_SECRET=CHANGE_ME_GENERATE_YOUR_OWN_SECRET_MIN_64_CHARS
JWT_ISSUER=Perfo
JWT_AUDIENCE=Perfo.Client
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
JWT_SOCKET_TOKEN_EXPIRATION_SECONDS=300

# ---- Brand ----
BRAND_NAME=Perfo
BRAND_DISPLAY_NAME=PERFO
BRAND_TAGLINE=Vé điện tử · Không cần in
BRAND_SUPPORT_EMAIL=

# ---- Booking / Rate limit ----
BOOKING_CHECK_IN_OPEN_MINUTES=30
RATE_LIMIT_GLOBAL_SEGMENTS_PER_WINDOW=4

# ---- Showtime scheduler ----
SCHEDULER_DEFAULT_WINDOW_MINUTES=960
SCHEDULER_SPREAD_MINUTES=30
SCHEDULER_FIT_WEIGHT=4
SCHEDULER_LOAD_WEIGHT=0.5

# ---- Background jobs (Hangfire) ----
BG_RELEASE_EXPIRED_SEATS_CRON=* * * * *
BG_SHOWTIME_LIFECYCLE_CRON=* * * * *
BG_RETRY_ATTEMPTS=3

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMTP (MailKit) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@perfo.local
SMTP_FROM_NAME=

# ---- Resend----
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# ---- VNPay (sandbox) ----
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/booking/result
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ---- MoMo (sandbox) ----
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5173/booking/result
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo/ipn
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund

# ---- Stripe (test) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=http://localhost:5173/booking/result
STRIPE_CURRENCY=vnd

# ---- Gemini AI ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Frontend (Vite build-time vars — baked in at build, not runtime) ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SIGNALR_HUB_URL=http://localhost:8080/hubs/showtimes
VITE_GOOGLE_CLIENT_ID=
