{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:full": "tsc -b && vite build && node scripts/build-sitemap.mjs",
    "sitemap:build": "node scripts/build-sitemap.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:load:browse": "powershell -ExecutionPolicy Bypass -File ../load-tests/run-load-test.ps1 -Scenario browse-movies-stress.js",
    "test:load:peak": "powershell -ExecutionPolicy Bypass -File ../load-tests/run-load-test.ps1 -Scenario peak-ticket-rush.js",
    "test:load": "npm run test:load:browse && npm run test:load:peak"
  },
  "dependencies": {
