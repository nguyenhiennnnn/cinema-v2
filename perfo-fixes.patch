diff --git a/frontend/src/hooks/use-quick-create.ts b/frontend/src/hooks/use-quick-create.ts
new file mode 100644
index 0000000..1d60ddb
--- /dev/null
+++ b/frontend/src/hooks/use-quick-create.ts
@@ -0,0 +1,56 @@
+import { useState } from "react";
+
+interface UseQuickCreateParams<TOption, TBody> {
+  /** Hàm tạo (thường là `mutateAsync` của hook create). Phải trả `{ data: TOption }`. */
+  create: (body: TBody) => Promise<{ data: TOption }>;
+  /** Chuyển chuỗi người dùng gõ thành body gửi lên API. */
+  toBody: (name: string) => TBody;
+  /** Gọi sau khi tạo thành công, thường để chọn luôn mục mới vào form. */
+  onCreated: (option: TOption) => void;
+}
+
+/**
+ * Tạo nhanh một mục danh mục ngay trong form khác, không phải rời trang.
+ *
+ * - `created`: các mục vừa tạo trong phiên này. Gộp vào `options` bằng `mergeOptions`
+ *   để mục mới hiện ngay, không phải chờ refetch danh sách.
+ * - Lỗi API đã được `MutationCache` toàn cục hiển thị toast, nên ở đây chỉ nuốt lỗi
+ *   để không bị unhandled rejection.
+ */
+export function useQuickCreate<TOption, TBody>({
+  create,
+  toBody,
+  onCreated,
+}: UseQuickCreateParams<TOption, TBody>) {
+  const [created, setCreated] = useState<TOption[]>([]);
+  const [isCreating, setIsCreating] = useState(false);
+
+  const quickCreate = async (name: string) => {
+    setIsCreating(true);
+    try {
+      const res = await create(toBody(name));
+      setCreated((prev) => [...prev, res.data]);
+      onCreated(res.data);
+    } catch {
+      // toast lỗi do MutationCache toàn cục xử lý
+    } finally {
+      setIsCreating(false);
+    }
+  };
+
+  /** Dùng khi mục được tạo ở nơi khác (VD: dialog) và chỉ cần ghi nhận lại. */
+  const remember = (option: TOption) => setCreated((prev) => [...prev, option]);
+
+  return { quickCreate, remember, created, isCreating };
+}
+
+/** Gộp danh sách từ server với các mục vừa tạo, loại trùng theo khóa. */
+export function mergeOptions<T>(
+  base: T[],
+  extra: T[],
+  getKey: (option: T) => string | number,
+): T[] {
+  const map = new Map<string | number, T>();
+  for (const option of [...base, ...extra]) map.set(getKey(option), option);
+  return [...map.values()];
+}
