VITE_API_BASE_URL=http://localhost:8080/api/v1

VITE_SIGNALR_HUB_URL=http://localhost:8080/hubs/showtimes

VITE_GOOGLE_CLIENT_ID=

# URL công khai của frontend (dùng cho canonical URLs và sitemap)
VITE_SITE_URL=http://localhost:5173

# ---- Timezone / Locale / Currency ----
# Phải khớp với Brand:TimeZoneId trong appsettings.json của backend.
# IANA timezone ID: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
VITE_BUSINESS_TIME_ZONE=Asia/Ho_Chi_Minh
# BCP-47 locale (format số, ngày)
VITE_LOCALE=vi-VN
# ISO 4217 currency code
VITE_CURRENCY_CODE=VND
# Ký hiệu tiền tệ hiển thị sau số (hậu tố)
VITE_CURRENCY_SYMBOL=VNĐ

# ---- E2E Testing ----
E2E_BASE_URL=http://localhost:5173
E2E_CUSTOMER_EMAIL=customer@cinema.local
E2E_CUSTOMER_PASSWORD=Customer@123
E2E_ADMIN_EMAIL=admin@cinema.local
E2E_ADMIN_PASSWORD=Admin@123

# ---- Production (Vercel) ----
# Đặt các biến sau trên Vercel Dashboard > Settings > Environment Variables:
# VITE_API_BASE_URL=https://<perfo-api-render-domain>/api/v1
# VITE_SIGNALR_HUB_URL=https://<perfo-api-render-domain>/hubs/showtimes
# VITE_GOOGLE_CLIENT_ID=<your-google-client-id>
# VITE_SITE_URL=https://<your-vercel-domain>
# VITE_BUSINESS_TIME_ZONE=Asia/Ho_Chi_Minh
# VITE_LOCALE=vi-VN
# VITE_CURRENCY_CODE=VND
# VITE_CURRENCY_SYMBOL=VNĐ
